{
  "Name": "DesignCraft CLI",
  "Description": "Practical DesignCraft layout, publishing, and rotary controls for OpenDeck (Linux).",
  "Author": "LuizGustavoWT",
  "Version": "0.2.1",
  "PluginUUID": "wt.luizgustavo.getcraft.designcraft",
  "CodePaths": {
    "x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/getcraft-designcraft-opendeck"
  },
  "CodePathLin": "x86_64-unknown-linux-gnu/bin/getcraft-designcraft-opendeck",
  "Icon": "assets/icon",
  "Category": "GetCraft",
  "OS": [{ "Platform": "linux" }],
  "Actions": [{
    "UUID": "wt.luizgustavo.getcraft.designcraft.run",
    "Name": "Run DesignCraft CLI",
    "Icon": "assets/action",
    "States": [{
      "Image": "assets/action",
      "TitleAlignment": "bottom",
      "TitleColor": "#FFFFFF",
      "FontSize": "12"
    }],
    "Controllers": ["Keypad", "Encoder"],
    "SupportedInMultiActions": true,
    "Tooltip": "Run any DesignCraft CLI command using safe JSON arguments.",
    "PropertyInspectorPath": "propertyInspector/run.html"
  }, {
    "UUID": "wt.luizgustavo.getcraft.designcraft.workflow",
    "Name": "DesignCraft Layout Tool",
    "Icon": "assets/action",
    "States": [{"Image":"assets/action","TitleAlignment":"bottom","TitleColor":"#FFFFFF","FontSize":"12"}],
    "Controllers": ["Keypad", "Encoder"],
    "SupportedInMultiActions": true,
    "Tooltip": "Create and open documents, make frames and layers, arrange selected objects, save, and export print-ready PDF.",
    "PropertyInspectorPath": "propertyInspector/workflow.html"
  }, {
    "UUID": "wt.luizgustavo.getcraft.designcraft.rotary",
    "Name": "DesignCraft Rotary",
    "Icon": "assets/action",
    "States": [{"Image":"assets/action","TitleAlignment":"bottom","TitleColor":"#FFFFFF","FontSize":"12"}],
    "Controllers": ["Encoder"],
    "SupportedInMultiActions": false,
    "Tooltip": "Turn to zoom, nudge, or rotate the selected layout; push to fit or save.",
    "PropertyInspectorPath": "propertyInspector/rotary.html"
  }]
}
